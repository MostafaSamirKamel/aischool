# ==============================================================================
# AI SCHOOL - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and customize values for your deployment target.
# NEVER commit the actual .env file or real credentials to version control.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="AI School"
# Runtime | Options: local, staging, production
APP_ENV=production
# Runtime | Set to false in production!
APP_DEBUG=false
# Runtime | Required 32-character key generated via: php artisan key:generate --show
APP_KEY=base64:YOUR_APP_KEY_GENERATE_VIA_ARTISAN=
# Runtime | Primary public URL of the application (e.g., https://your-domain.up.railway.app)
APP_URL=http://localhost:8000
# Runtime | System timezone
APP_TIMEZONE=Africa/Cairo
# Runtime | Default locale (ar: Arabic, en: English)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Web Server Port (Railway automatically sets PORT at runtime; default is 8080)
PORT=8080

# Maintenance Driver
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime | In Docker and Railway, use 'stderr' or 'stack' with stderr to stream logs to console
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime | Options: mysql, pgsql, sqlite, mariadb
DB_CONNECTION=mysql

# For local Docker Compose:
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ai_school
DB_USERNAME=ai_school
DB_PASSWORD=secret

# For Railway MySQL Plugin:
# Railway provides MYSQL_URL or individual variables. If using Railway MySQL,
# you can either set DB_URL=${{MySQL.MYSQL_URL}} or map:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_URL=

# Run migrations automatically in container entrypoint (true/false)
# Set to 'false' if running migrations via Railway preDeployCommand
RUN_MIGRATIONS=false

# ------------------------------------------------------------------------------
# 4. CACHE, SESSIONS & QUEUES
# ------------------------------------------------------------------------------
# Runtime | In production multi-replica, use 'redis' or 'database'
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue: In production with background workers, use 'redis' or 'database'
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# 5. REDIS CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# For Railway Redis Plugin:
# REDIS_HOST=${{Redis.REDISHOST}}
# REDIS_PORT=${{Redis.REDISPORT}}
# REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
# REDIS_USER=${{Redis.REDISUSER}}
# REDIS_URL=${{Redis.REDIS_URL}}

# ------------------------------------------------------------------------------
# 6. CORS & API SETTINGS (For Student PWA & External Consumers)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for Sanctum and API CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=true

# Domains for Sanctum cookie-based SPA authentication (comma-separated)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:8000,127.0.0.1:8000

# ------------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime | Options: log (for dev), smtp (for production), ses, mailgun, postmark
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@aischool.test"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 8. WHATSAPP GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Options: log, sog, ultramsg
WHATSAPP_DEFAULT_DRIVER=log
WHATSAPP_QUEUE=true
WHATSAPP_LOG=true
WHATSAPP_RATE_LIMIT_PER_MINUTE=5
WHATSAPP_RATE_LIMIT_PER_HOUR=50

# SOG WhatsApp (Egyptian Government Gateway)
SOG_WHATSAPP_API_URL=https://sender.whatsapp.sog.eg/api
SOG_WHATSAPP_API_KEY=YOUR_SOG_API_KEY
SOG_WHATSAPP_SENDER=YOUR_SOG_SENDER_ID

# Ultramsg WhatsApp (Alternative Gateway)
ULTRAMSG_INSTANCE_ID=YOUR_ULTRAMSG_INSTANCE_ID
ULTRAMSG_TOKEN=YOUR_ULTRAMSG_TOKEN

# ------------------------------------------------------------------------------
# 9. SMS GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Options: log, twilio, vonage, vodafone
SMS_DEFAULT_DRIVER=log
SMS_QUEUE=true
SMS_LOG=true
SMS_RATE_LIMIT_PER_MINUTE=10
SMS_RATE_LIMIT_PER_HOUR=100

# Twilio SMS
TWILIO_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM=YOUR_TWILIO_SENDER_NUMBER

# Vonage / Nexmo SMS
VONAGE_KEY=YOUR_VONAGE_API_KEY
VONAGE_SECRET=YOUR_VONAGE_API_SECRET
VONAGE_FROM=YOUR_VONAGE_SENDER_NAME

# Vodafone Egypt SMS
VODAFONE_USERNAME=YOUR_VODAFONE_USERNAME
VODAFONE_PASSWORD=YOUR_VODAFONE_PASSWORD
VODAFONE_SENDER=YOUR_VODAFONE_SENDER

# ------------------------------------------------------------------------------
# 10. S3 / OBJECT STORAGE (Optional: For cloud storage instead of local disk)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 11. FRONTEND BUILD-TIME VARIABLES (Vite)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
