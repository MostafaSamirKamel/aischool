# Version control & IDE
.git
.gitignore
.gitattributes
.editorconfig
.idea
.vscode
.fleet

# Environment & credentials (NEVER commit or bake into images)
.env
.env.*
!.env.example
auth.json
cookie.txt

# Local vendor & node dependencies (re-installed cleanly during build)
node_modules
vendor

# Framework caches & logs
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail/*
!storage/logs/.gitkeep
!storage/framework/cache/data/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep

# Local database files (retain pre-migrated sqlite database for instant deployment)
database/*.sqlite-journal
database/*.sqlite3-journal
database/*.bak*
database/backups/*
!database/database.sqlite

# Temporary / testing files
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
exams_qa
reports
.styling_checkpoint_backup
