<?php

namespace App\Filament\Supervisor\Resources\Students;

use App\Filament\Supervisor\Resources\Students\Pages\CreateStudent;
use App\Filament\Supervisor\Resources\Students\Pages\EditStudent;
use App\Filament\Supervisor\Resources\Students\Pages\ListStudents;
use App\Filament\Supervisor\Resources\Students\Pages\ViewStudent;
use App\Filament\Supervisor\Resources\Students\Schemas\StudentForm;
use App\Filament\Supervisor\Resources\Students\Schemas\StudentInfolist;
use App\Filament\Supervisor\Resources\Students\Tables\StudentsTable;
use App\Models\Student;
use BackedEnum;
use Filament\Resources\Resource;
use Filament\Schemas\Schema;
use Filament\Support\Icons\Heroicon;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\SoftDeletingScope;

class StudentResource extends Resource
{
    protected static ?string $model = Student::class;

    protected static ?string $navigationLabel = null;

    protected static ?string $modelLabel = null;

    protected static ?string $pluralModelLabel = null;

    protected static string|BackedEnum|null $navigationIcon = Heroicon::OutlinedAcademicCap;

    protected static ?string $recordTitleAttribute = 'student_id';

    protected static ?int $navigationSort = 2;

    public static function getNavigationGroup(): ?string
    {
        return 'الإشراف';
    }

    public static function form(Schema $schema): Schema
    {
        return StudentForm::configure($schema);
    }

    public static function infolist(Schema $schema): Schema
    {
        return StudentInfolist::configure($schema);
    }

    public static function table(Table $table): Table
    {
        return StudentsTable::configure($table);
    }

    public static function getRelations(): array
    {
        return [
            //
        ];
    }

    public static function getPages(): array
    {
        return [
            'index' => ListStudents::route('/'),
            'view' => ViewStudent::route('/{record}'),
        ];
    }

    public static function getEloquentQuery(): Builder
    {
        $supervisor = auth()->user()->supervisor;
        
        // Get IDs of groups supervised by this supervisor
        $groupIds = \App\Models\Group::where('supervisor_id', $supervisor?->id)->pluck('id');
        
        return parent::getEloquentQuery()
            ->whereHas('groups', function ($query) use ($groupIds) {
                $query->whereIn('group_id', $groupIds);
            })
            ->with(['user', 'groups']);
    }

    public static function getRecordRouteBindingEloquentQuery(): Builder
    {
        return parent::getRecordRouteBindingEloquentQuery()
            ->withoutGlobalScopes([
                SoftDeletingScope::class,
            ]);
    }
    public static function getNavigationLabel(): string
    {
        return __('filament/supervisor/student_resource.navigation_label');
    }
    public static function getModelLabel(): string
    {
        return __('filament/supervisor/student_resource.model_label');
    }
    public static function getPluralModelLabel(): string
    {
        return __('filament/supervisor/student_resource.plural_model_label');
    }



}
