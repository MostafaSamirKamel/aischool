<?php

namespace App\Filament\Admin\Resources\Occupations\Tables;

use Filament\Actions\BulkActionGroup;
use Filament\Actions\DeleteBulkAction;
use Filament\Actions\EditAction;
use Filament\Tables\Table;

class OccupationsTable
{
    public static function configure(Table $table): Table
    {
        $user = auth()->user();
        $isSuperAdmin = $user && $user->is_super_admin && is_null($user->tenant_id);

        return $table
            ->columns([
                \Filament\Tables\Columns\TextColumn::make('tenant.name')
                    ->label(__('filament/admin/occupation_resource.tenant.name'))
                    ->searchable()
                    ->sortable()
                    ->visible($isSuperAdmin),

                \Filament\Tables\Columns\TextColumn::make('name')
                    ->label(__('filament/admin/occupation_resource.name'))
                    ->searchable()
                    ->sortable(),

                \Filament\Tables\Columns\TextColumn::make('description')
                    ->label(__('filament/admin/occupation_resource.description'))
                    ->limit(50)
                    ->toggleable(),

                \Filament\Tables\Columns\IconColumn::make('is_active')
                    ->label(__('filament/admin/occupation_resource.is_active'))
                    ->boolean(),

                \Filament\Tables\Columns\TextColumn::make('created_at')
                    ->label(__('filament/admin/occupation_resource.created_at'))
                    ->dateTime()
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: true),
            ])
            ->filters([
                \Filament\Tables\Filters\TernaryFilter::make('is_active')
                    ->label(__('filament/admin/occupation_resource.is_active'))
                    ->boolean()
                    ->trueLabel(__('filament/admin/occupation_resource.active_only'))
                    ->falseLabel(__('filament/admin/occupation_resource.inactive_only')),
            ])
            ->recordActions([
                EditAction::make()
                    ->visible(fn() => !auth()->user()->is_super_admin),
                \Filament\Actions\DeleteAction::make()
                    ->visible(fn() => !auth()->user()->is_super_admin),
            ])
            ->toolbarActions([
                BulkActionGroup::make([
                    DeleteBulkAction::make()
                        ->visible(fn() => !auth()->user()->is_super_admin),
                ]),
            ])
            ->defaultSort('name', 'asc');
    }
}
