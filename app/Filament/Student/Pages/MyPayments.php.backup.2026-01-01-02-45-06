<?php

namespace App\Filament\Student\Pages;

use BackedEnum;
use Filament\Tables;
use App\Models\Payment;
use Filament\Pages\Page;
use App\Models\Enrollment;
use Filament\Tables\Table;
use Filament\Actions\Action;
use Filament\Tables\Contracts\HasTable;
use Filament\Forms\Components\DatePicker;
use Filament\Tables\Concerns\InteractsWithTable;

class MyPayments extends Page implements HasTable
{
    use InteractsWithTable;

    protected string $view = 'filament.student.pages.my-payments';

    protected static string | BackedEnum | null $navigationIcon = 'heroicon-o-credit-card';
    
    protected static ?int $navigationSort = 40;

    public static function getNavigationLabel(): string
    {
        return __('مدفوعاتي');
    }

    public function getTitle(): string
    {
        return __('مدفوعاتي واشتراكاتي');
    }

    public function getHeading(): string
    {
        return __('مدفوعاتي واشتراكاتي');
    }

    public function table(Table $table): Table
    {
        $student = auth()->user()->student;
        
        // Get enrollment IDs for this student
        $enrollmentIds = Enrollment::where('student_id', $student?->id)->pluck('id');

        return $table
            ->query(
                Payment::query()
                    ->whereIn('enrollment_id', $enrollmentIds)
                    ->with(['enrollment.group.course'])
                    ->orderBy('payment_date', 'desc')
            )
            ->columns([
                Tables\Columns\TextColumn::make('payment_code')
                    ->label(__('رقم الدفعة'))
                    ->searchable()
                    ->weight('bold')
                    ->icon('heroicon-o-hashtag')
                    ->copyable()
                    ->copyMessage(__('تم النسخ'))
                    ->color('primary'),

                Tables\Columns\TextColumn::make('enrollment.group.course.name')
                    ->label(__('الكورس'))
                    ->searchable()
                    ->badge()
                    ->color('info'),

                Tables\Columns\TextColumn::make('enrollment.group.name')
                    ->label(__('المجموعة'))
                    ->badge()
                    ->color('success'),

                Tables\Columns\TextColumn::make('amount')
                    ->label(__('المبلغ'))
                    ->money('EGP')
                    ->sortable()
                    ->weight('bold')
                    ->icon('heroicon-o-banknotes'),

                Tables\Columns\TextColumn::make('payment_date')
                    ->label(__('تاريخ الدفع'))
                    ->date('d/m/Y')
                    ->sortable()
                    ->icon('heroicon-o-calendar'),

                Tables\Columns\TextColumn::make('payment_method')
                    ->label(__('طريقة الدفع'))
                    ->formatStateUsing(fn ($state) => match ($state) {
                        'cash' => 'نقدي',
                        'card' => 'بطاقة',
                        'bank_transfer' => 'تحويل بنكي',
                        'online' => 'دفع إلكتروني',
                        default => $state,
                    })
                    ->badge()
                    ->color('gray'),

                Tables\Columns\TextColumn::make('status')
                    ->label(__('الحالة'))
                    ->formatStateUsing(fn ($state) => match ($state) {
                        'completed' => 'مكتمل',
                        'pending' => 'قيد الانتظار',
                        'failed' => 'فشل',
                        'refunded' => 'مسترد',
                        default => $state,
                    })
                    ->badge()
                    ->color(fn ($state) => match ($state) {
                        'completed' => 'success',
                        'pending' => 'warning',
                        'failed' => 'danger',
                        'refunded' => 'gray',
                        default => 'gray',
                    }),
            ])
            ->filters([
                Tables\Filters\SelectFilter::make('status')
                    ->label(__('الحالة'))
                    ->options([
                        'completed' => 'مكتمل',
                        'pending' => 'قيد الانتظار',
                        'failed' => 'فشل',
                        'refunded' => 'مسترد',
                    ]),
                    
                Tables\Filters\SelectFilter::make('payment_method')
                    ->label(__('طريقة الدفع'))
                    ->options([
                        'cash' => 'نقدي',
                        'card' => 'بطاقة',
                        'bank_transfer' => 'تحويل بنكي',
                        'online' => 'دفع إلكتروني',
                    ]),
                    
                Tables\Filters\Filter::make('created_at')
                    ->form([
                        DatePicker::make('from')
                            ->label(__('من تاريخ')),
                        DatePicker::make('until')
                            ->label(__('إلى تاريخ')),
                    ])
                    ->query(function ($query, array $data) {
                        return $query
                            ->when($data['from'], fn ($q) => $q->whereDate('payment_date', '>=', $data['from']))
                            ->when($data['until'], fn ($q) => $q->whereDate('payment_date', '<=', $data['until']));
                    }),
            ])
            ->actions([
                Action::make('view_receipt')
                    ->label(__('عرض الإيصال'))
                    ->icon('heroicon-o-document-text')
                    ->color('info')
                    ->visible(fn ($record) => $record->status === 'completed')
                    ->modalHeading(fn ($record) => __('إيصال دفع رقم') . ' ' . $record->payment_code)
                    ->modalContent(fn ($record) => view('filament.student.pages.payment-receipt-modal', [
                        'payment' => $record,
                    ]))
                    ->modalWidth('3xl')
                    ->modalSubmitAction(false)
                    ->modalCancelActionLabel(__('إغلاق')),

                // Download receipt action - disabled until route is created
                // Action::make('download_receipt')
                //     ->label(__('تحميل الإيصال'))
                //     ->icon('heroicon-o-arrow-down-tray')
                //     ->color('success')
                //     ->visible(fn ($record) => $record->status === 'completed')
                //     ->url(fn ($record) => route('student.payment.receipt', $record))
                //     ->openUrlInNewTab(),
            ])
            ->emptyStateHeading(__('لا توجد مدفوعات'))
            ->emptyStateDescription(__('لم تقم بأي مدفوعات بعد'))
            ->emptyStateIcon('heroicon-o-credit-card');
    }
}
