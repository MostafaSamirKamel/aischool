<?php

namespace App\Filament\Instructor\Resources\LearningResources\Schemas;

use App\Models\Course;
use App\Models\Group;
use Filament\Forms\Components\FileUpload;
use Filament\Forms\Components\Radio;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\Textarea;
use Filament\Forms\Components\TextInput;
use Filament\Forms\Components\Toggle;
use Filament\Schemas\Components\Utilities\Get;
use Filament\Schemas\Components\Grid;
use Filament\Schemas\Components\Section;
use Filament\Schemas\Schema;

class LearningResourceForm
{
    public static function configure(Schema $schema): Schema
    {
        return $schema
            ->schema([
                Section::make('معلومات المادة')
                    ->schema([
                        TextInput::make('title')
                            ->label(__('filament/instructor/learning_resource_resource.title'))
                            ->required()
                            ->maxLength(255)
                            ->columnSpanFull(),

                        Textarea::make('description')
                            ->label(__('filament/instructor/learning_resource_resource.description'))
                            ->rows(3)
                            ->maxLength(1000)
                            ->columnSpanFull(),

                        Grid::make(2)
                            ->schema([
                                Select::make('type')
                                    ->label(__('filament/instructor/learning_resource_resource.type'))
                                    ->required()
                                    ->options(['pdf' => __('filament/instructor/learning_resource_resource.type.pdf'), 'video' => __('filament/instructor/learning_resource_resource.type.video'), 'presentation' => __('filament/instructor/learning_resource_resource.type.presentation'), 'document' => __('filament/instructor/learning_resource_resource.type.document'), 'image' => __('filament/instructor/learning_resource_resource.type.image'), 'audio' => __('filament/instructor/learning_resource_resource.type.audio'), 'link' => __('filament/instructor/learning_resource_resource.type.link'), 'other' => __('filament/instructor/learning_resource_resource.type.other')])
                                    ->native(false)
                                    ->live(),

                                Radio::make('visibility')
                                    ->label(__('filament/instructor/learning_resource_resource.visibility'))
                                    ->options([
                                        'all' => 'جميع الطلاب',
                                        'course' => 'طلاب الكورس فقط',
                                        'group' => 'طلاب المجموعة فقط',
                                    ])
                                    ->default('all')
                                    ->required()
                                    ->inline()
                                    ->live(),
                            ]),
                    ]),

                Section::make('ربط المادة')
                    ->schema([
                        Grid::make(2)
                            ->schema([
                                Select::make('course_id')
                                    ->label(__('filament/instructor/learning_resource_resource.course_id'))
                                    ->searchable()
                                    ->options(function () {
                                        return Course::whereHas('groups', function ($query) {
                                            $query->where('instructor_id', auth()->id());
                                        })
                                        ->pluck('name', 'id');
                                    })
                                    ->live()
                                    ->visible(fn (Get $get) => in_array($get('visibility'), ['course', 'group'])),

                                Select::make('group_id')
                                    ->label(__('filament/instructor/learning_resource_resource.group_id'))
                                    ->searchable()
                                    ->options(function (Get $get) {
                                        $query = Group::where('instructor_id', auth()->id());
                                        
                                        if ($courseId = $get('course_id')) {
                                            $query->where('course_id', $courseId);
                                        }
                                        
                                        return $query->pluck('name', 'id');
                                    })
                                    ->visible(fn (Get $get) => $get('visibility') === 'group'),
                            ]),
                    ])
                    ->visible(fn (Get $get) => in_array($get('visibility'), ['course', 'group'])),

                Section::make('رفع الملف أو الرابط')
                    ->schema([
                        FileUpload::make('file_path')
                            ->label(__('filament/instructor/learning_resource_resource.file_path'))
                            ->disk('public')
                            ->directory('learning-resources')
                            ->maxSize(51200) // 50MB
                            ->acceptedFileTypes([
                                'application/pdf',
                                'application/msword',
                                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                                'application/vnd.ms-excel',
                                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                                'application/vnd.ms-powerpoint',
                                'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                                'image/*',
                                'video/*',
                                'audio/*',
                            ])
                            ->previewable()
                            ->downloadable()
                            ->openable()
                            ->visible(fn (Get $get) => $get('type') !== 'link')
                            ->helperText('الحد الأقصى: 50 ميجابايت')
                            ->afterStateUpdated(function ($state, callable $set) {
                                if ($state) {
                                    // Get file info
                                    $file = is_array($state) ? $state[0] : $state;
                                    if ($file instanceof \Livewire\Features\SupportFileUploads\TemporaryUploadedFile) {
                                        $set('file_name', $file->getClientOriginalName());
                                        $set('file_size', round($file->getSize() / 1024, 2)); // KB
                                        $set('file_extension', $file->getClientOriginalExtension());
                                    }
                                }
                            }),

                        TextInput::make('external_link')
                            ->label(__('filament/instructor/learning_resource_resource.external_link'))
                            ->url()
                            ->maxLength(500)
                            ->visible(fn (Get $get) => $get('type') === 'link')
                            ->helperText('مثال: رابط يوتيوب، جوجل درايف، إلخ')
                            ->columnSpanFull(),
                    ]),

                Section::make('الإعدادات')
                    ->schema([
                        Grid::make(2)
                            ->schema([
                                Toggle::make('is_downloadable')
                                    ->label(__('filament/instructor/learning_resource_resource.is_downloadable'))
                                    ->default(true)
                                    ->helperText('السماح للطلاب بتحميل الملف'),

                                Toggle::make('is_active')
                                    ->label(__('filament/instructor/learning_resource_resource.is_active'))
                                    ->default(true)
                                    ->helperText('إظهار المادة للطلاب'),
                            ]),
                    ]),
            ]);
    }
}
