#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Ensure required runtime storage directories exist
foreach ([
    __DIR__.'/storage/framework/cache/data',
    __DIR__.'/storage/framework/sessions',
    __DIR__.'/storage/framework/views',
    __DIR__.'/storage/logs',
    __DIR__.'/bootstrap/cache',
    __DIR__.'/database',
] as $runtimeDir) {
    if (!is_dir($runtimeDir)) {
        @mkdir($runtimeDir, 0777, true);
    }
}

// Ensure SQLite database file exists if SQLite connection is used
$sqlitePath = __DIR__.'/database/database.sqlite';
if (!file_exists($sqlitePath)) {
    @touch($sqlitePath);
}

// Resilient database fallback: If no explicit remote DB host or URL is given in environment,
// default to pre-migrated sqlite database to ensure instant edge and serverless operation.
if (empty($_ENV['DB_HOST']) && empty(getenv('DB_HOST')) && empty($_ENV['DATABASE_URL']) && empty(getenv('DATABASE_URL'))) {
    if (file_exists($sqlitePath)) {
        $_ENV['DB_CONNECTION'] = 'sqlite';
        putenv('DB_CONNECTION=sqlite');
        $realDbPath = realpath($sqlitePath) ?: $sqlitePath;
        $_ENV['DB_DATABASE'] = $realDbPath;
        putenv("DB_DATABASE={$realDbPath}");
    }
}

// In automated deployment platforms (e.g. Wasmer, cloud build hooks) where migrations
// are invoked non-interactively without --force, automatically inject --force to prevent prompts
if (isset($_SERVER['argv']) && in_array('migrate', $_SERVER['argv']) && !in_array('--force', $_SERVER['argv'])) {
    $_SERVER['argv'][] = '--force';
}

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';


$status = $app->handleCommand(new ArgvInput);

// If migrate was executed successfully and the database is fresh (no users), seed initial roles and admin
if ($status === 0 && isset($_SERVER['argv']) && in_array('migrate', $_SERVER['argv'])) {
    try {
        if (\Illuminate\Support\Facades\Schema::hasTable('users') && \App\Models\User::count() === 0) {
            \Illuminate\Support\Facades\Artisan::call('db:seed', [
                '--class' => 'Database\\Seeders\\TenantSeeder',
                '--force' => true,
            ]);
            \Illuminate\Support\Facades\Artisan::call('db:seed', [
                '--class' => 'Database\\Seeders\\RolePermissionSeeder',
                '--force' => true,
            ]);
            \Illuminate\Support\Facades\Artisan::call('db:seed', [
                '--class' => 'Database\\Seeders\\DemoUserSeeder',
                '--force' => true,
            ]);
        }
    } catch (\Throwable $e) {
        // Safe fallback - avoid interrupting deployment if seeding fails
    }
}

exit($status);
